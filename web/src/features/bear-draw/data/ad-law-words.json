{
  "version": 1,
  "updated": "2026-10-25",
  "note": "图内文字和文案的广告法提示词表。用法：逐条做子串匹配，命中就提示并给出建议说法；只提示、不自动替换，最终由用户决定。level：ban = 默认不用；evidence = 有真实依据（检测报告、专利号、销售数据、官方文件）才能用，并要写明出处；category = 特定类目（药品、医疗器械、保健食品、特殊化妆品等）以外不能用。市场监管总局 2023 年《广告绝对化用语执法指南》说明：只表达经营理念、企业内部型号比较、时间先后等情况不一定违法，但为了省事，默认还是换掉。这份表是常识整理，不是法律意见。",
  "basis": [
    {
      "id": "ad-9-3",
      "name": "《广告法》第九条第（三）项",
      "summary": "广告不得使用「国家级」「最高级」「最佳」等用语。"
    },
    {
      "id": "ad-9-2",
      "name": "《广告法》第九条第（二）项",
      "summary": "不得使用或者变相使用国家机关、国家机关工作人员的名义或者形象。"
    },
    {
      "id": "ad-9-8",
      "name": "《广告法》第九条第（八）项",
      "summary": "不得含有淫秽、色情、赌博、迷信、恐怖、暴力的内容。"
    },
    {
      "id": "ad-11",
      "name": "《广告法》第十一条",
      "summary": "引用数据、统计资料、调查结果、文摘、引用语等，应当真实、准确，并表明出处。"
    },
    {
      "id": "ad-12",
      "name": "《广告法》第十二条",
      "summary": "广告中涉及专利的，应当标明专利号和专利种类；未取得专利权的不得谎称取得专利权。"
    },
    {
      "id": "ad-17",
      "name": "《广告法》第十七条",
      "summary": "除医疗、药品、医疗器械广告外，禁止其他广告涉及疾病治疗功能，不得使用医疗用语或者易与药品、医疗器械混淆的用语。"
    },
    {
      "id": "ad-28",
      "name": "《广告法》第二十八条",
      "summary": "以虚假或者引人误解的内容欺骗、误导消费者的，构成虚假广告。"
    },
    {
      "id": "tm-14",
      "name": "《商标法》第十四条第五款",
      "summary": "生产、经营者不得将「驰名商标」字样用于商品、包装、容器或者广告宣传等商业活动。"
    },
    {
      "id": "price",
      "name": "《价格法》《明码标价和禁止价格欺诈规定》",
      "summary": "不得虚构原价、虚假优惠；标示「原价」等被比较价格要真实，通常指促销前 7 日内的最低成交价。"
    }
  ],
